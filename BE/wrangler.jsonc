{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dance-competition-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-03",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dance-competition-db",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		"crons": ["*/5 * * * *"]
	}
}
